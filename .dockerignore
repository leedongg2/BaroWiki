# 이미지에 넣지 않는 것
#
#  주의 : views/ 와 lang/ 은 실행 파일 안에 박히므로 반드시 빌드에 들어가야 한다.
#         여기에 적으면 안 된다.

.git
.github
.gitignore

# 실행 파일 · 데이터 (컨테이너 안에서 새로 만든다)
*.exe
*.bin
onamu
*.db
*.db-shm
*.db-wal
data/
!data/.gitkeep

# Netlify 앞단 (원본 서버 이미지에는 필요 없다)
netlify/
netlify.toml

# 문서 · 작업 부스러기
*.md
!readme.md
batch*.json
baro_keys.json
baro_wrapped_keys.txt
core_strings.txt
ckS.txt
rk.html
app.py
--help
